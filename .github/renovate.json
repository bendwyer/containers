{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "separateMinorPatch": true,
  "github-actions": { "enabled": false },
  "customManagers": [
    {
      "description": "Alpine release embedded in a compound tag; the dockerfile manager preserves the suffix and never moves it.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["FROM \\S+:\\S*-alpine(?<currentValue>\\d+\\.\\d+)"],
      "depNameTemplate": "alpine",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Talker wheel; a direct download URL is not a tracked dependency, so it went six months stale unseen.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)requirements\\.txt$/"],
      "matchStrings": ["releases/download/(?<currentValue>[^/]+)/mangabaka_talker-[^-]+-py3-none-any\\.whl"],
      "autoReplaceStringTemplate": "releases/download/{{{newValue}}}/mangabaka_talker-{{{newValue}}}-py3-none-any.whl",
      "depNameTemplate": "mizaki/mangabaka_talker",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Pin digests for all docker images.",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "A mid-tag value has no digest of its own. Grouped so the standard moves in one PR.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["alpine"],
      "pinDigests": false,
      "groupName": "alpine base"
    },
    {
      "description": "Automerge patch+minor+digest for >=1.x",
      "matchDatasources": ["docker", "npm"],
      "matchCurrentVersion": "/^v?[1-9]/",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge patch+digest only for 0.x",
      "matchDatasources": ["docker", "npm"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "A minor here is a release line change, so review it.",
      "matchPackageNames": ["node", "python", "golang", "alpine"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "typescript-eslint's peer range caps typescript below 6.1, so a 7.x update cannot resolve.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "The talker implements comictagger's plugin API and nothing declares the range, so move them together.",
      "matchPackageNames": ["comictagger", "mizaki/mangabaka_talker"],
      "groupName": "mangabaka pair"
    },
    {
      "description": "A .dev snapshot is not a release, and an already-unstable pin disables ignoreUnstable.",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["comictagger"],
      "allowedVersions": "!/\\.dev/"
    }
  ]
}
