{
  "name": "tailscale-exit-nodes",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Control plane for self-service Tailscale exit-node deployments (AWS Lightsail + Vultr) with a TTL.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "ci": "npm run format:check && npm run check",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^10.0.0",
    "pg-mem": "^3.0.5",
    "prettier": "^3.4.2",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
